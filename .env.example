# Copy this file to .env and edit. Everything here has a safe default,
# so the app runs out of the box without any configuration.

# --- Flask ---
SECRET_KEY=change-me-in-production
FLASK_DEBUG=1

# --- Reporting cycle ---
# Sites still "Pending" after this date are automatically flagged "Overdue"
# on every page load. Defaults to <year>-12-31 if unset.
PFAS_REPORTING_YEAR=2026
PFAS_DEADLINE=2026-12-31

# --- Email (SMTP) ---
# DRY RUN is ON by default: reminders are generated and logged to the database
# but NOT actually sent. Set to 0 only when you have real SMTP credentials.
EMAIL_DRY_RUN=1
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=pfas-reporting@example.com

# --- AI summary provider ---
# placeholder = deterministic rule-based stub (no API key needed)
# api         = real LLM API call (requires the provider SDK + ANTHROPIC_API_KEY)
AI_PROVIDER=placeholder
ANTHROPIC_API_KEY=
AI_MODEL=
